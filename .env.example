# Copy to .env and replace the placeholder values. .env is never committed.
# Every value below is a fake placeholder; never put real credentials here.

# Use Development to get Swagger and the HTTPS redirect when running locally.
ASPNETCORE_ENVIRONMENT=Production

# At least 8 characters with upper, lower, digit and symbol, or SQL Server refuses to start.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng_Pass1
# Keep it below the memory given to the container; SQL Server needs 2 GB to start.
MSSQL_MEMORY_LIMIT_MB=4096

API_PORT=8080

# Origins of the two React fronts allowed by CORS.
CORS_ORIGIN_BACKOFFICE=http://localhost:5173
CORS_ORIGIN_PUBLIC=http://localhost:5174

# true creates and updates the database on startup (local). Use false in production and run --migrar.
MIGRACIONES_APLICAR_AL_INICIAR=true

# Signing key for employee JWTs (Jwt__Key). At least 32 characters.
JWT_KEY=change-me-local-jwt-key-at-least-32-chars

# API keys that external groups send in X-Api-Key (ApiKeys__<provider>).
APIKEY_PASARELA1=change-me-pasarela1-key
APIKEY_PASARELA2=change-me-pasarela2-key

# Keys this API sends to external services (Integraciones__<Service>__ApiKey).
# Only used when that service runs with Integraciones:<Service>:UsarMock=false.
INTEGRACIONES_RENAPER_APIKEY=change-me-renaper-key
INTEGRACIONES_DNRPA_APIKEY=change-me-dnrpa-key
INTEGRACIONES_ARCA_APIKEY=change-me-arca-key
INTEGRACIONES_PASARELA1_APIKEY=change-me-pasarela1-outbound-key
INTEGRACIONES_PASARELA2_APIKEY=change-me-pasarela2-outbound-key

# Only needed with `docker compose --profile tunnel up`.
CLOUDFLARE_TUNNEL_TOKEN=
