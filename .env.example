# Copy to .env and replace the placeholder values. .env is never committed.
# Every value below is a fake placeholder; never put real credentials here.
#
# This file defaults to local development. On the production VM change the three
# values marked "Production:" (ASPNETCORE_ENVIRONMENT, MIGRACIONES_APLICAR_AL_INICIAR,
# SWAGGER_HABILITADO) and see docs/despliegue.md.

# Development (local): Swagger and the HTTPS redirect are on.
# Production: the VM runs with Production.
ASPNETCORE_ENVIRONMENT=Development

# At least 8 characters with upper, lower, digit and symbol, or SQL Server refuses to start.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng_Pass1
# Keep it below the memory given to the 2 GB to start.
# Production: use 2048 on a 4 GB VM so the API and the tunnel keep enough memory.
MSSQL_MEMORY_LIMIT_MB=4096

API_PORT=8080

# Origins of the two React fronts allowe
# Local: the Vite dev servers. Production: the Cloudflare Pages domains of both fronts.
CORS_ORIGIN_BACKOFFICE=http://localhost:
CORS_ORIGIN_PUBLIC=http://localhost:5174

# true creates and updates the database
# Production: false, and run `docker compose run --rm api --migrar` on each deploy.
MIGRACIONES_APLICAR_AL_INICIAR=true

# true publishes Swagger UI (local). Production: false.
SWAGGER_HABILITADO=true

# Signing key for employee JWTs (Jwt__Key). At least 32 characters.
JWT_KEY=change-me-local-jwt-key-at-least-32-chars

# Initial administrator created on startup (Seed__Administrador__*). Leave empty to skip it.
# The password must meet the ASP.NET Identity policy (upper, lower, digit and symbol).
SEED_ADMINISTRADOR_EMAIL=admin@example.
SEED_ADMINISTRADOR_PASSWORD=ChangeMe_Admin1!

# API keys that external groups send inr>).
APIKEY_PASARELA1=change-me-pasarela1-key
APIKEY_PASARELA2=change-me-pasarela2-key

# Keys this API sends to external services (Integraciones__<Service>__ApiKey).
# Only used when that service runs with Integraciones:<Service>:UsarMock=false.
INTEGRACIONES_RENAPER_APIKEY=change-me-renaper-key
INTEGRACIONES_DNRPA_APIKEY=change-me-dnrpa-key
INTEGRACIONES_ARCA_APIKEY=change-me-arca-key
INTEGRACIONES_PASARELA1_APIKEY=change-me-pasarela1-outbound-key
INTEGRACIONES_PASARELA2_APIKEY=change-me-pasarela2-outbound-key

# Only needed on the production VM with `docker compose --profile tunnel up`.                           It is the connector token (a long string) for the Tunnel ID.
# Never set it on a second machine: two connectors would split the traffic.
CLOUDFLARE_TUNNEL_TOKEN=
# Datos fiscales de prueba (reemplazar por los acordados con ARCA). IVA incluido: 21 %.
FACTURACION_CUIT=00000000000
FACTURACION_PUNTO_VENTA=1
